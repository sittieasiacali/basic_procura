APP_NAME="ASI PROCURA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://procura.example.org
APP_TIMEZONE=Asia/Manila

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=basic_procura
DB_USERNAME=procura
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=30
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Optional document label overrides; by default use the recorded actors.
PROCUREMENT_BR_REQUESTED_BY=
PROCUREMENT_BR_APPROVED_BY=

# System Health (Admin > System Health, php artisan health:check)
HEALTH_STUCK_DAYS=3
HEALTH_ALERT_EMAIL=
