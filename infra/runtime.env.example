# Prepare-Bundle.ps1 creates runtime.env from the current app without exposing keys.
COMPOSE_PROJECT_NAME=procura
PROCURA_APP_IMAGE=procura/app:local
PROCURA_WEB_IMAGE=procura/web:local
PROCURA_DB_IMAGE=mariadb:10.11
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
APP_NAME="ASI PROCURA"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Manila
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=basic_procura
DB_USERNAME=procura
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.allianz-synergia.com
MAIL_PORT=465
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=30
MAIL_USERNAME=businessdev.app@allianz-synergia.com
MAIL_FROM_ADDRESS=businessdev.app@allianz-synergia.com
MAIL_FROM_NAME="ASI PROCURA"
